{
  "name": "coverforge-studio",
  "version": "2.1.2",
  "description": "Copertine, loghi, icone, header e immagini per blog: un LLM scrive il prompt, un modello grafico crea l'immagine (via OpenRouter)",
  "main": "electron.js",
  "private": true,
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "check": "node --check server.js && node --check electron.js && node --check start.js && node scripts/check-public.js",
    "web": "node start.js",
    "dist": "electron-builder --publish never",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "26.15.3",
    "playwright": "1.56.1"
  },
  "author": "querogiuseppe61-stack",
  "license": "MIT",
  "desktopName": "coverforge-studio.desktop",
  "homepage": "https://github.com/querogiuseppe61-stack/coverforge-studio",
  "build": {
    "appId": "io.github.querogiuseppe61-stack.coverforge",
    "productName": "CoverForge Studio",
    "asar": false,
    "files": [
      "server.js",
      "electron.js",
      "package.json",
      "public/**",
      "prompt-guide/cover-forge.md",
      "prompt-master-main/SKILL.md",
      "prompt-master-main/LICENSE",
      "prompt-master-main/references/**",
      "assets/icon.png",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "assets/linux",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CoverForge-Studio-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "assets/icon.png",
      "identity": null
    },
    "appImage": {
      "artifactName": "CoverForge-Studio-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "CoverForge-Studio-${version}-${arch}.${ext}"
    }
  }
}
